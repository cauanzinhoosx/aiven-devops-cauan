# Copie para .env (uso local) OU configure como variável no Render.
AIVEN_DB_URL=postgres://avnadmin:SENHA@nome-do-servico-projeto.a.aivencloud.com:PORTA/defaultdb?sslmode=require
# Dados de futebol via ESPN pública, sem chave. Configurações abaixo são opcionais.
# ESPN_TEAM_ID=2022
# ESPN_LEAGUE=bra.1
# ESPN_SEASON=2026
PORT=8080
CACHE_HOURS=6
FAILED_REFRESH_COOLDOWN_MINUTES=15
